{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "margin",
  "account_id": "dc134a18f1e88ea687bcd38982ef46e9",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-15",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI",
    "remote": true
  }
}
