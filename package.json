{
  "name": "margin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "build": "tsc -b && vite build",
    "lint": "oxlint src",
    "test": "vitest run",
    "preview": "vite preview",
    "deploy:worker": "npm run build && wrangler deploy",
    "deploy:pages": "npm run build && node scripts/deploy-pages.mjs",
    "deploy": "npm run deploy:worker && npm run deploy:pages",
    "deploy:all": "npm run deploy",
    "deploy:temporary": "npm run build && wrangler deploy --temporary"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.8",
    "lucide-react": "^0.468.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^4.1.0",
    "wrangler": "^4.56.0"
  }
}
